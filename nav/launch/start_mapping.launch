<launch>
    <!-- 全局参数 -->
    <arg name="use_sim_time" default="true" doc="使用仿真时间，实体机器人设为false"/>
    <param name="use_sim_time" value="$(arg use_sim_time)"/>

    <!-- 0. 启动robot_model -->
    <include file="$(find robot_base)/launch/start_stm32.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>


    <!-- 1. 启动SLAM建图 - 使用slam_toolbox -->
    <include file="$(find gmapping)/launch/slam_toolbox.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>
    
    <!-- 1.1 启动gmapping建图 -->
    <!-- <include file="$(find gmapping)/launch/slam_gmapping_pr2.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include> -->

    <!-- 2. 启动move_base导航 -->
    <include file="$(find nav)/launch/move_base.launch" />

    <!-- 3. 启动自主探索节点 -->
    <include file="$(find nav)/launch/explore.launch" />

    <!-- 4. 可选：启动RViz可视化 -->
    <arg name="rviz" default="true" doc="启动RViz进行可视化"/>
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find nav)/rviz/mapping.rviz" if="$(eval arg('rviz') == true)"/>
    </group>

    <!-- 5. 可选：启动地图保存器 -->
    <arg name="auto_save_map" default="false" doc="是否自动保存地图"/>
    <arg name="map_file" default="$(find nav)/maps/map" doc="地图保存路径"/>
    <group if="$(arg auto_save_map)">
        <node pkg="map_server" type="map_saver" name="map_saver" args="-f $(arg map_file)" output="screen">
            <param name="save_interval" value="60.0"/>
        </node>
    </group>
</launch>
