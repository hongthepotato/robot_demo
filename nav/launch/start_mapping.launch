<launch>
    <!-- 全局参数 -->
    <arg name="use_sim_time" default="true" doc="使用仿真时间，实体机器人设为false"/>
    <param name="use_sim_time" value="$(arg use_sim_time)"/>

    <!-- 0. 启动robot_model -->
    <include file="$(find robot_base)/launch/start_stm32.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>


    <!-- 1. 启动SLAM建图 - 使用slam_toolbox -->
    <!-- <include file="$(find gmapping)/launch/slam_toolbox.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include> -->
    
    <!-- 1.1 启动gmapping建图 -->
    <include file="$(find gmapping)/launch/slam_gmapping_pr2.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>

    <!-- 2. 启动move_base导航 -->
    <include file="$(find nav)/launch/move_base.launch" />

    <!-- 3. 启动自主探索节点 -->
    <!-- <include file="$(find nav)/launch/explore.launch" /> -->
    
    <!-- 3. 整合自主探索节点和四元数初始化节点 -->
    <node pkg="explore_lite" type="explore" respawn="false" name="explore" output="screen">
      <param name="robot_base_frame" value="base_footprint"/>
      <param name="costmap_topic" value="map"/>
      <!-- <param name="costmap_updates_topic" value="map_updates"/> -->
      <param name="visualize" value="true"/>
      <param name="planner_frequency" value="0.5"/>
      <param name="progress_timeout" value="20.0"/>
      <param name="potential_scale" value="3.0"/>
      <param name="orientation_scale" value="0.5"/>
      <param name="gain_scale" value="1.0"/>
      <param name="transform_tolerance" value="0.3"/>
      <param name="min_frontier_size" value="0.5"/>
    </node>
    
    <!-- 3.1 添加MarkerArray四元数初始化节点 -->
    <node pkg="tf" type="static_transform_publisher" name="frontier_orientation_initializer" 
          args="0 0 0 0 0 0 1 map frontier 100" />

    <!-- 4. 可选：启动RViz可视化 -->
    <arg name="rviz" default="true" doc="启动RViz进行可视化"/>
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find nav)/rviz/mapping.rviz" if="$(eval arg('rviz') == true)"/>
    </group>

    <!-- 5. 可选：启动地图保存器 -->
    <arg name="auto_save_map" default="false" doc="是否自动保存地图"/>
    <arg name="map_file" default="$(find nav)/maps/map" doc="地图保存路径"/>
    <group if="$(arg auto_save_map)">
        <node pkg="map_server" type="map_saver" name="map_saver" args="-f $(arg map_file)" output="screen">
            <param name="save_interval" value="60.0"/>
        </node>
    </group>
</launch>
