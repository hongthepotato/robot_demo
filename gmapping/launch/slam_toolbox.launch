<launch>
    <!-- 添加启动参数，默认为仿真模式 -->
    <arg name="use_sim_time" default="true"/>
    
    <!-- 使用参数值设置use_sim_time -->
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
    
    <!-- 启动 slam_toolbox 异步在线建图节点 -->
    <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
        <!-- 加载配置文件中的所有参数 -->
        <rosparam command="load" file="$(find gmapping)/config/mapper_params_online_async.yaml" />
        
        <!-- 可选：覆盖 YAML 中的某些参数 -->
        <!-- <param name="resolution" value="0.05"/> -->
        <!-- <param name="max_laser_range" value="20.0"/> -->
    </node>
    
    <!-- 可选：添加 RViz 可视化 -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find slam_toolbox)/rviz/slam_toolbox_default.rviz"/> -->
</launch>
